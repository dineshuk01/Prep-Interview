# OpenAI API Key for TTS and LLM services
OPENAI_API_KEY=your_openai_api_key_here

# Groq API Key for fast LLM inference (Llama-3.3-70b)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# MongoDB Connection String (e.g. MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=ai_interview_platform

# Frontend URL (for CORS if running on separate domains)
FRONTEND_URL=http://localhost:3000
